{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://axl-lang.dev/schema/axl-ir-1.1.schema.json",
    "title": "AXL IR 1.1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "ir_version",
        "program"
    ],
    "properties": {
        "ir_version": {
            "const": "1.1"
        },
        "program": {
            "$ref": "#/$defs/program"
        }
    },
    "$defs": {
        "value": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "integer"
                },
                {
                    "type": "boolean"
                }
            ]
        },
        "identifier": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
                "enum": [
                    "agent",
                    "call",
                    "else",
                    "emit",
                    "end",
                    "false",
                    "fn",
                    "forget",
                    "if",
                    "import",
                    "let",
                    "memory",
                    "meta",
                    "recall",
                    "return",
                    "run",
                    "true",
                    "uses",
                    "while",
                    "workflow"
                ]
            }
        },
        "qualifiedIdentifier": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "typeName": {
            "enum": [
                "int",
                "string",
                "bool"
            ]
        },
        "expression": {
            "oneOf": [
                {
                    "$ref": "#/$defs/literal"
                },
                {
                    "$ref": "#/$defs/variable"
                },
                {
                    "$ref": "#/$defs/recall"
                },
                {
                    "$ref": "#/$defs/toolCall"
                },
                {
                    "$ref": "#/$defs/functionCall"
                },
                {
                    "$ref": "#/$defs/binary"
                }
            ]
        },
        "instruction": {
            "oneOf": [
                {
                    "$ref": "#/$defs/memoryWrite"
                },
                {
                    "$ref": "#/$defs/forget"
                },
                {
                    "$ref": "#/$defs/let"
                },
                {
                    "$ref": "#/$defs/return"
                },
                {
                    "$ref": "#/$defs/emit"
                },
                {
                    "$ref": "#/$defs/if"
                },
                {
                    "$ref": "#/$defs/while"
                },
                {
                    "$ref": "#/$defs/agent"
                },
                {
                    "$ref": "#/$defs/workflow"
                },
                {
                    "$ref": "#/$defs/run"
                },
                {
                    "$ref": "#/$defs/function"
                }
            ]
        },
        "program": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "instructions"
            ],
            "properties": {
                "type": {
                    "const": "Program"
                },
                "instructions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/instruction"
                    }
                }
            }
        },
        "literal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "value"
            ],
            "properties": {
                "type": {
                    "const": "Literal"
                },
                "value": {
                    "$ref": "#/$defs/value"
                }
            }
        },
        "variable": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name"
            ],
            "properties": {
                "type": {
                    "const": "Variable"
                },
                "name": {
                    "$ref": "#/$defs/identifier"
                }
            }
        },
        "recall": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "key"
            ],
            "properties": {
                "type": {
                    "const": "Recall"
                },
                "key": {
                    "$ref": "#/$defs/identifier"
                }
            }
        },
        "toolCall": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name",
                "arguments"
            ],
            "properties": {
                "type": {
                    "const": "ToolCall"
                },
                "name": {
                    "$ref": "#/$defs/identifier"
                },
                "arguments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/expression"
                    }
                }
            }
        },
        "functionCall": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name",
                "arguments"
            ],
            "properties": {
                "type": {
                    "const": "FunctionCall"
                },
                "name": {
                    "$ref": "#/$defs/qualifiedIdentifier"
                },
                "arguments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/expression"
                    }
                }
            }
        },
        "binary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "left",
                "operator",
                "right"
            ],
            "properties": {
                "type": {
                    "const": "Binary"
                },
                "left": {
                    "$ref": "#/$defs/expression"
                },
                "operator": {
                    "enum": [
                        "+",
                        "-",
                        "*",
                        "/",
                        "==",
                        "!=",
                        ">",
                        "<",
                        ">=",
                        "<="
                    ]
                },
                "right": {
                    "$ref": "#/$defs/expression"
                }
            }
        },
        "memoryWrite": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "key",
                "value",
                "confidence",
                "ttl_seconds",
                "source"
            ],
            "properties": {
                "type": {
                    "const": "MemoryWrite"
                },
                "key": {
                    "$ref": "#/$defs/identifier"
                },
                "value": {
                    "$ref": "#/$defs/expression"
                },
                "confidence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                },
                "ttl_seconds": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "integer",
                            "minimum": 1
                        }
                    ]
                },
                "source": {
                    "$ref": "#/$defs/identifier"
                }
            }
        },
        "forget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "key"
            ],
            "properties": {
                "type": {
                    "const": "Forget"
                },
                "key": {
                    "$ref": "#/$defs/identifier"
                }
            }
        },
        "let": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "target",
                "value",
                "type_name"
            ],
            "properties": {
                "type": {
                    "const": "Let"
                },
                "target": {
                    "$ref": "#/$defs/identifier"
                },
                "value": {
                    "$ref": "#/$defs/expression"
                },
                "type_name": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/typeName"
                        }
                    ]
                }
            }
        },
        "return": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "value"
            ],
            "properties": {
                "type": {
                    "const": "Return"
                },
                "value": {
                    "$ref": "#/$defs/expression"
                }
            }
        },
        "emit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "value"
            ],
            "properties": {
                "type": {
                    "const": "Emit"
                },
                "value": {
                    "$ref": "#/$defs/expression"
                }
            }
        },
        "if": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "condition",
                "body",
                "else_body"
            ],
            "properties": {
                "type": {
                    "const": "If"
                },
                "condition": {
                    "$ref": "#/$defs/expression"
                },
                "body": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/instruction"
                    }
                },
                "else_body": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/instruction"
                    }
                }
            }
        },
        "while": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "condition",
                "body"
            ],
            "properties": {
                "type": {
                    "const": "While"
                },
                "condition": {
                    "$ref": "#/$defs/expression"
                },
                "body": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/instruction"
                    }
                }
            }
        },
        "agent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name",
                "tools",
                "body"
            ],
            "properties": {
                "type": {
                    "const": "Agent"
                },
                "name": {
                    "$ref": "#/$defs/identifier"
                },
                "tools": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/identifier"
                    },
                    "uniqueItems": true
                },
                "body": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/instruction"
                    }
                }
            }
        },
        "workflow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name",
                "body"
            ],
            "properties": {
                "type": {
                    "const": "Workflow"
                },
                "name": {
                    "$ref": "#/$defs/identifier"
                },
                "body": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/instruction"
                    }
                }
            }
        },
        "run": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name"
            ],
            "properties": {
                "type": {
                    "const": "Run"
                },
                "name": {
                    "$ref": "#/$defs/identifier"
                }
            }
        },
        "parameter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name",
                "type_name"
            ],
            "properties": {
                "type": {
                    "const": "Parameter"
                },
                "name": {
                    "$ref": "#/$defs/identifier"
                },
                "type_name": {
                    "$ref": "#/$defs/typeName"
                }
            }
        },
        "function": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "name",
                "parameters",
                "return_type",
                "body"
            ],
            "properties": {
                "type": {
                    "const": "Function"
                },
                "name": {
                    "$ref": "#/$defs/qualifiedIdentifier"
                },
                "parameters": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/parameter"
                    }
                },
                "return_type": {
                    "$ref": "#/$defs/typeName"
                },
                "body": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/instruction"
                    }
                }
            }
        }
    }
}
