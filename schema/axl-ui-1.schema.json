{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axl-lang.dev/schema/axl-ui-1.schema.json",
  "title": "AXL UI Manifest 1",
  "type": "object",
  "required": ["schema", "app", "protocol", "uis"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ax-ir/4.0" },
    "app": { "type": "string", "minLength": 1 },
    "protocol": { "const": "axl-ui/1" },
    "uis": {
      "type": "array",
      "items": { "$ref": "#/$defs/ui" }
    }
  },
  "$defs": {
    "ui": {
      "type": "object",
      "required": ["name", "pages"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/page" },
          "minItems": 1
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["path", "input", "output", "flow"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "flow": { "type": "string", "minLength": 1 }
      }
    }
  }
}
