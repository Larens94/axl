{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axl-lang.dev/schema/axl-http-1.schema.json",
  "title": "AXL HTTP Manifest 1",
  "type": "object",
  "required": ["schema", "app", "protocol", "apis"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ax-ir/4.0" },
    "app": { "type": "string", "minLength": 1 },
    "protocol": { "const": "axl-http/1" },
    "apis": {
      "type": "array",
      "items": { "$ref": "#/$defs/api" }
    }
  },
  "$defs": {
    "api": {
      "type": "object",
      "required": ["name", "routes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/route" },
          "minItems": 1
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["method", "path", "input", "output", "flow"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["get", "post", "put", "patch", "delete"] },
        "path": { "type": "string", "pattern": "^/" },
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "flow": { "type": "string", "minLength": 1 }
      }
    }
  }
}
