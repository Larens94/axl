axl 4
app InvalidHttpAuthSyntax
flow Identity text -> text
  return input
api BrokenApi
  auth bearer HttpAuth
  auth bearer: HttpAuth = First
  auth bearer: HttpAuth = Second
  post /identity text -> text = Identity
  get /broken text -> text = Identity from header.value
  bind orphan = body
  get /mixed/{id} text -> text = Identity from path.id
    bind value = body
