// Expected diagnostics: AXL-X802, AXL-N806, AXL-X871 through AXL-X879 and AXL-X881 through AXL-X884.
axl 4
app InvalidFlowTransforms

entity Input
  amount: money required
  items: List<int> required
  flags: List<bool> required

flow NonCollection Input -> List<money>
  map values: List<money> = input.amount as item
    value = item
  return values

flow NonCollectionResult Input -> money
  map values: money = input.items as item
    value = item
  return input.amount

flow ChangedFilterType Input -> List<money>
  filter values: List<money> = input.items as item
    where = item > 0
  return values

flow NonBooleanFilter Input -> List<int>
  filter values: List<int> = input.items as item
    where = item
  return values

flow WrongMapValue Input -> List<int>
  map values: List<int> = input.items as item
    value = "invalid"
  return values

flow ReservedItem Input -> List<int>
  map values: List<int> = input.items as input
    value = input
  return values

flow NonCollectionSort Input -> List<int>
  sort values: List<int> = input.amount as item
    by = item
    direction = asc
  return values

flow WrongSortResult Input -> Set<int>
  sort values: Set<int> = input.items as item
    by = item
    direction = asc
  return values

flow UnsortableKey Input -> List<bool>
  sort values: List<bool> = input.flags as item
    by = item
    direction = asc
  return values

flow InvalidDirection Input -> List<int>
  sort values: List<int> = input.items as item
    by = item
    direction = sideways
  return values

flow NonCollectionGroup Input -> Map<text,List<int>>
  group values: Map<text,List<int>> = input.amount as item
    by = "all"
  return values

flow WrongGroupResult Input -> Map<text,List<money>>
  group values: Map<text,List<money>> = input.items as item
    by = "all"
  return values

flow UnorderedGroupKey Input -> Map<bool,List<bool>>
  group values: Map<bool,List<bool>> = input.flags as item
    by = item
  return values

flow WrongGroupKeyType Input -> Map<uuid,List<int>>
  group values: Map<uuid,List<int>> = input.items as item
    by = "all"
  return values

flow EmptyListLiteral Input -> List<int>
  let values = []
  return values

flow MixedListLiteral Input -> List<int>
  let values = [1, "two"]
  return values
