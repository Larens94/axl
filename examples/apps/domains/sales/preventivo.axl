flow InviaPreventivo uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = MemoriaPreventivi
  in clienti: ArchivioClienti = MemoriaClienti
  in mailer: EmailSender = MemoriaEmail
  in pdf: PdfRenderer = MemoriaPdf
  call trovato = store.find(input)?
  match stato_inviabile: bool = trovato.stato
    bozza => true
    inviato => false
    confermato => false
  require stato_inviabile else "stato_non_inviabile"
  call cliente = clienti.find(trovato.cliente_id)?
  make doc: PdfDocument
    id = trovato.id
    title = "Preventivo"
    totale = trovato.totale
  call pdf_ref = pdf.render(doc)?
  make email: EmailMessage
    to = cliente.email
    subject = "Preventivo inviato"
    body = "Preventivo inviato"
    attachment_id = pdf_ref
  call inviato_id = mailer.send(email)?
  match nuovo_stato: StatoPreventivo = trovato.stato
    bozza => StatoPreventivo.inviato
    inviato => StatoPreventivo.inviato
    confermato => StatoPreventivo.confermato
  make aggiornato: Preventivo
    id = trovato.id
    cliente_id = trovato.cliente_id
    stato = nuovo_stato
    righe = trovato.righe
    totale = trovato.totale
  run valida = ValidaPreventivo(aggiornato)?
  call salvato = store.save(valida)?
  return salvato

flow ConfermaPreventivo uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = MemoriaPreventivi
  call trovato = store.find(input)?
  match stato_confermable: bool = trovato.stato
    bozza => false
    inviato => true
    confermato => false
  require stato_confermable else "stato_non_confermable"
  match nuovo_stato: StatoPreventivo = trovato.stato
    bozza => StatoPreventivo.bozza
    inviato => StatoPreventivo.confermato
    confermato => StatoPreventivo.confermato
  make aggiornato: Preventivo
    id = trovato.id
    cliente_id = trovato.cliente_id
    stato = nuovo_stato
    righe = trovato.righe
    totale = trovato.totale
  run valida = ValidaPreventivo(aggiornato)?
  call salvato = store.save(valida)?
  return salvato

