flow CercaPreventiviPerStatoDemoUnit PreventivoQuery -> Result<PreventivoPage>
  in store: ArchivioPreventivi = MemoriaPreventivi
  make riga_bozza: RigaPreventivo
    prodotto_id = "prodotto-001"
    quantita = 1
    prezzo_unitario = 129900
    importo = 129900
  make preventivo_bozza: Preventivo
    id = "preventivo-001"
    cliente_id = "cliente-001"
    stato = StatoPreventivo.bozza
    righe = [riga_bozza]
    totale = 129900
  run valida_bozza = ValidaPreventivo(preventivo_bozza)?
  call salvato_bozza = store.save(valida_bozza)?
  make riga_inviato: RigaPreventivo
    prodotto_id = "prodotto-002"
    quantita = 2
    prezzo_unitario = 2990
    importo = 5980
  make preventivo_inviato: Preventivo
    id = "preventivo-002"
    cliente_id = "cliente-002"
    stato = StatoPreventivo.inviato
    righe = [riga_inviato]
    totale = 5980
  run valida_inviato = ValidaPreventivo(preventivo_inviato)?
  call salvato_inviato = store.save(valida_inviato)?
  run pagina = CercaPreventiviPerStato(input)?
  return pagina

