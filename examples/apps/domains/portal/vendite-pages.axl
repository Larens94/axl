flow DettaglioListinoSessioneDemoUnit unit -> Result<Listino>
  run login = LoginAdminDemoUnit(input)?
  run _seed = SeedListinoDemoUnit(input)?
  make gate: DettaglioSessioneInput
    session_id = login.session_id
    id = "listino-001"
  run trovato = DettaglioListinoSessione(gate)?
  return trovato

flow DettaglioPreventivoSessioneDemoUnit unit -> Result<Preventivo>
  run login = LoginAdminDemoUnit(input)?
  run _seed = SeedPreventivoDemoUnit(input)?
  make gate: DettaglioSessioneInput
    session_id = login.session_id
    id = "preventivo-001"
  run trovato = DettaglioPreventivoSessione(gate)?
  return trovato

flow DettaglioOrdineSessioneDemoUnit unit -> Result<Ordine>
  run login = LoginAdminDemoUnit(input)?
  run ordine = CreaOrdineDaPreventivoDemoUnit(input)?
  make gate: DettaglioSessioneInput
    session_id = login.session_id
    id = ordine.id
  run trovato = DettaglioOrdineSessione(gate)?
  return trovato

flow PaginaClientiRbacDemoUnit unit -> Result<ClientePage>
  run _init = InizializzaAuthDemo(input)?
  make check: PermessoCheck
    utente_id = "utente-admin"
    codice = "vendite.clienti.read"
  run _ = RichiediPermesso(check)?
  run pagina = PaginaClientiDemoUnit(input)?
  return pagina
