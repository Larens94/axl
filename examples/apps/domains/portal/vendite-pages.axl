flow PaginaClientiRbacDemoUnit unit -> Result<ClientePage>
  run _init = InizializzaAuthDemo(input)?
  make check: PermessoCheck
    utente_id = "utente-admin"
    codice = "vendite.clienti.read"
  run _ = RichiediPermesso(check)?
  run pagina = PaginaClientiDemoUnit(input)?
  return pagina
