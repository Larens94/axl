// Portal vendite UI handlers: session-gated page flows over sales domain.
axl 4
app PortalVenditePages

flow PaginaClientiSessione uuid -> Result<ClientePage>
  make gate: SessionePermessoInput
    session_id = input
    permesso = "vendite.clienti.read"
  run _ = RequireSessionPermesso(gate)?
  in store: ArchivioClienti = MemoriaClienti
  make query: ClienteQuery
    order_by = "nome"
    direction = "asc"
    limit = 10
    offset = 0
  call pagina = store.query(query)?
  return pagina

