flow DettaglioListinoSessione DettaglioSessioneInput -> Result<Listino>
  make gate: SessionePermessoInput
    session_id = input.session_id
    permesso = "vendite.listini.read"
  run _ = RequireSessionPermesso(gate)?
  run trovato = CercaListino(input.id)?
  return trovato

