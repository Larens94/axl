// Portal framework core: session + RBAC middleware (Axum-style guards in AXL).
axl 4
app PortalCore

entity SessionePermessoInput
  session_id: uuid required
  permesso: text required

entity DettaglioSessioneInput
  session_id: uuid required
  id: uuid required

flow RequireSession uuid -> Result<Utente>
  run utente = UtenteDaSessionePortal(input)?
  return utente

flow RequireSessionPermesso SessionePermessoInput -> Result<Utente>
  run utente = UtenteDaSessionePortal(input.session_id)?
  make check: PermessoCheck
    utente_id = utente.id
    codice = input.permesso
  run _ = RichiediPermessoPortal(check)?
  return utente
