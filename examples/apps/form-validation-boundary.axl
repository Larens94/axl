// Gate 4 form validation UX — failed require re-renders HTML form with field errors.
axl 4
app FormValidationBoundary

enum ClienteStato
  attivo
  inattivo

entity Cliente
  nome: text required
  email: email required
  budget: money required
  stato: ClienteStato required

flow CreaCliente Cliente -> Result<Cliente>
  require input.nome != "" else "nome_required"
  return input

flow ListaClienti unit -> text
  return "clienti"

api ClienteApi
  post /clienti Cliente -> Result<Cliente> = CreaCliente

ui ClienteScreen
  page /clienti unit -> text = ListaClienti
  form /clienti/new Cliente -> Result<Cliente> = CreaCliente submit /clienti redirect /clienti
