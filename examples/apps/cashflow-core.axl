// First executable AXL cashflow core: validation and money arithmetic.
axl 4
app CashflowCore

enum MovementKind
  income
  expense

entity Movement
  id: uuid required
  kind: MovementKind required
  amount: money required
  category: text required
  occurred_at: datetime required
  note: text optional

entity BalanceInput
  income: money required
  expense: money required

entity MovementView
  id: uuid required
  direction: text required
  signed_amount: money required
  category: text required

entity MovementBatch
  movements: List<Movement> required

entity MovementPair
  first: Movement required
  second: Movement required

entity MovementLookupBatch
  ids: List<uuid> required

entity MovementQuery
  filter: Map<text,text> optional
  order_by: text optional
  direction: text optional
  limit: int optional
  offset: int optional

entity MovementPage
  items: List<Movement> required
  total: int required
  limit: int required
  offset: int required

entity MovementPreviewRequest
  account: uuid required
  movement: Movement required
  dry_run: bool required

entity ClientSessionRequest
  user: text required
  sid: text required
  movement: Movement required

capacity MovementStore
  op save Movement -> Result<Movement>
  op find uuid -> Result<Movement> idempotent
  op query MovementQuery -> Result<MovementPage> idempotent

capacity HttpAuth
  op authorize text -> Result<bool> idempotent

entity HttpRequest
  method: text required
  path: text required
  headers: Map<text,text> required

entity HttpResponse
  status: int required
  headers: Map<text,text> required
  body: text required

capacity HttpMiddleware
  op process HttpRequest -> Result<HttpRequest> idempotent

capacity HttpResponseMiddleware
  op process HttpResponse -> Result<HttpResponse> idempotent

capacity EventLog
  op append text -> Result<text>
  op list unit -> Result<List<text>>

skill MemoryMovements provides MovementStore
  native rust axl::store::memory
  effect db.read
  effect db.write

skill SqliteMovements provides MovementStore
  native rust axl::store::sqlite
  effect db.read
  effect db.write

skill DurableSqliteMovements provides MovementStore
  native rust axl::store::sqlite
  config path: text = "./build/cashflow-core.db"
  effect db.read
  effect db.write

skill DocumentMovements provides MovementStore
  native rust axl::store::document
  effect db.read
  effect db.write

skill DurableDocumentMovements provides MovementStore
  native rust axl::store::document
  config path: text = "./build/cashflow-core.document.json"
  effect db.read
  effect db.write

capacity TransactionManager
  op begin text -> Result<text>
  op commit text -> Result<unit>
  op rollback text -> Result<unit>

skill MemoryTransactions provides TransactionManager
  native rust axl::tx::memory
  effect db.write

skill DurableSqliteTransactions provides TransactionManager
  native rust axl::tx::sqlite
  config path: text = "./build/cashflow-core.db"
  effect db.write

capacity MigrationRunner
  op up text -> Result<text>
  op down text -> Result<text>
  op status unit -> Result<text>

skill MemoryMigrations provides MigrationRunner
  native rust axl::migrate::memory
  effect db.write

skill DurableSqliteMigrations provides MigrationRunner
  native rust axl::migrate::sqlite
  config path: text = "./build/cashflow-core.db"
  effect db.write

// Demo-only credential. Production secrets require the planned secret provider.
skill CashflowDemoBearer provides HttpAuth
  native rust axl::auth::bearer
  config token: text = "axl-cashflow-demo"
  capability auth.verify

// Demo-only HMAC secret and issuer in skill config (visible in Graph/manifest).
// True secret references (no plaintext in IR) are Gate 8; OAuth remains open.
skill CashflowDemoJwt provides HttpAuth
  native rust axl::auth::jwt
  config secret: text = "axl-cashflow-demo-jwt"
  config issuer: text = "axl-cashflow"
  capability auth.verify

skill CashflowClientGate provides HttpMiddleware
  native rust axl::middleware::header_gate
  config header: text = "x-axl-client"
  config value: text = "cashflow-demo"
  capability net.filter

skill CashflowResponseHeaders provides HttpResponseMiddleware
  native rust axl::middleware::response_headers
  config header: text = "x-axl-middleware"
  config value: text = "ok"
  capability net.filter

capacity RateLimit
  op allow text -> Result<bool> idempotent

skill MemoryRateLimit provides RateLimit
  native rust axl::middleware::rate_limit
  config limit: int = 5
  config window_ms: int = 60000
  capability net.filter

skill CashflowCorsOrigin provides HttpMiddleware
  native rust axl::middleware::cors
  config origin: text = "*"
  capability net.filter

skill CashflowCorsHeaders provides HttpResponseMiddleware
  native rust axl::middleware::cors
  config origin: text = "*"
  config methods: text = "GET,POST,OPTIONS"
  config headers: text = "content-type,authorization"
  capability net.filter

skill MemoryEventLog provides EventLog
  native rust axl::event::log

capacity JobStore
  op enqueue text -> Result<text> idempotent
  op claim unit -> Result<List<text>> idempotent
  op finish text -> Result<text>

skill MemoryJobs provides JobStore
  native rust axl::job::memory

skill DurableJobs provides JobStore
  native rust axl::job::sqlite
  config path: text = "./build/cashflow-jobs.db"

entity CacheEntry
  key: text required
  value: text required

capacity Cache
  op get text -> Result<text> idempotent
  op put CacheEntry -> Result<unit>
  op invalidate text -> Result<bool>

skill MemoryCache provides Cache
  native rust axl::cache::memory

skill DurableCache provides Cache
  native rust axl::cache::sqlite
  config path: text = "./build/cashflow-cache.db"

capacity Logger
  op write text -> Result<unit>
  op list unit -> Result<List<text>>

skill MemoryLogger provides Logger
  native rust axl::telemetry::logger

capacity Metrics
  op increment text -> Result<int>
  op get text -> Result<int> idempotent

skill MemoryMetrics provides Metrics
  native rust axl::telemetry::metrics

capacity Tracer
  op start text -> Result<text>
  op finish text -> Result<unit>
  op list unit -> Result<List<text>>

skill MemoryTracer provides Tracer
  native rust axl::telemetry::tracer

event MovementSaved: Movement

on MovementSaved Movement = TagMovementPersisted
on MovementSaved Movement = TagMovementAnnounced

job PersistMovementJob
  run ValidateAndStoreMovement
  retry 3
  idempotent
  in store: JobStore = MemoryJobs

job DurablePersistMovementJob
  run SaveDurableMovement
  retry 3
  idempotent
  in store: JobStore = DurableJobs

job MovementTickJob
  schedule "every 60s"
  run RecordJobTick
  retry 1
  idempotent
  in store: JobStore = MemoryJobs

flow ValidateMovement Movement -> Result<Movement>
  let known_kind = input.kind == MovementKind.income || input.kind == MovementKind.expense
  let positive_amount = input.amount > 0
  require known_kind else "movement_kind_invalid"
  require positive_amount else "amount_must_be_positive"
  return input

flow CalculateBalance BalanceInput -> money
  let balance = input.income - input.expense
  return balance

flow BuildMovementView Movement -> MovementView
  let direction = if input.kind == MovementKind.income then "Entrata" else "Uscita"
  match signed_amount: money = input.kind
    income => input.amount
    expense => -input.amount
  make view: MovementView
    id = input.id
    direction = direction
    signed_amount = signed_amount
    category = input.category
  return view

flow CalculateLedgerBalance MovementBatch -> money
  fold balance: money = input.movements from 0 as movement
    next = if movement.kind == MovementKind.income
      then value + movement.amount
      else value - movement.amount
  return balance

flow IncomeAmounts MovementBatch -> List<money>
  filter incomes: List<Movement> = input.movements as movement
    where = movement.kind == MovementKind.income
  map amounts: List<money> = incomes as movement
    value = movement.amount
  return amounts

flow SortMovementsNewest MovementBatch -> List<Movement>
  sort ordered: List<Movement> = input.movements as movement
    by = movement.occurred_at
    direction = desc
  return ordered

flow GroupMovementsByCategory MovementBatch -> Map<text,List<Movement>>
  group grouped: Map<text,List<Movement>> = input.movements as movement
    by = movement.category
  return grouped

flow DefaultCategories unit -> List<text>
  let categories = [
    "consulting",
    "software"
  ]
  return categories

flow BuildMovementViewsParallel MovementBatch -> List<MovementView>
  parallel views: List<MovementView> = input.movements as movement
    run = BuildMovementView(movement)
  return views

flow StoreAndLoadMovement Movement -> Result<Movement>
  in store: MovementStore = MemoryMovements
  call saved = store.save(input)?
  call loaded = store.find(saved.id)?
  return loaded

flow StoreAndLoadMovementSqlite Movement -> Result<Movement>
  in store: MovementStore = SqliteMovements
  call saved = store.save(input)?
  call loaded = store.find(saved.id)?
  return loaded

flow StoreAndLoadMovementDocument Movement -> Result<Movement>
  in store: MovementStore = DocumentMovements
  call saved = store.save(input)?
  call loaded = store.find(saved.id)?
  return loaded

flow SaveDurableMovement Movement -> Result<Movement>
  in store: MovementStore = DurableSqliteMovements
  call saved = store.save(input)?
  return saved

flow FindDurableMovement uuid -> Result<Movement>
  in store: MovementStore = DurableSqliteMovements
  call found = store.find(input)?
  return found

flow SaveDurableDocumentMovement Movement -> Result<Movement>
  in store: MovementStore = DurableDocumentMovements
  call saved = store.save(input)?
  return saved

flow FindDurableDocumentMovement uuid -> Result<Movement>
  in store: MovementStore = DurableDocumentMovements
  call found = store.find(input)?
  return found

flow QueryDurableMovements MovementQuery -> Result<MovementPage>
  in store: MovementStore = DurableSqliteMovements
  call page = store.query(input)?
  return page

flow QueryMovements MovementQuery -> Result<MovementPage>
  in store: MovementStore = MemoryMovements
  call page = store.query(input)?
  return page

flow QueryDocumentMovements MovementQuery -> Result<MovementPage>
  in store: MovementStore = DocumentMovements
  call page = store.query(input)?
  return page

flow QueryDurableDocumentMovements MovementQuery -> Result<MovementPage>
  in store: MovementStore = DurableDocumentMovements
  call page = store.query(input)?
  return page

flow CommitTwoDurableMovements MovementPair -> Result<Movement>
  in tx: TransactionManager = DurableSqliteTransactions
  in store: MovementStore = DurableSqliteMovements
  call tid = tx.begin("commit-two")?
  call first = store.save(input.first)?
  call second = store.save(input.second)?
  call done = tx.commit(tid)?
  return second

flow RollbackTwoDurableMovements MovementPair -> Result<unit>
  in tx: TransactionManager = DurableSqliteTransactions
  in store: MovementStore = DurableSqliteMovements
  call tid = tx.begin("rollback-two")?
  call first = store.save(input.first)?
  call second = store.save(input.second)?
  call done = tx.rollback(tid)?
  return done

flow CommitTwoMovements MovementPair -> Result<Movement>
  in tx: TransactionManager = MemoryTransactions
  in store: MovementStore = MemoryMovements
  call tid = tx.begin("commit-two")?
  call first = store.save(input.first)?
  call second = store.save(input.second)?
  call done = tx.commit(tid)?
  return second

flow RollbackTwoMovements MovementPair -> Result<unit>
  in tx: TransactionManager = MemoryTransactions
  in store: MovementStore = MemoryMovements
  call tid = tx.begin("rollback-two")?
  call first = store.save(input.first)?
  call second = store.save(input.second)?
  call done = tx.rollback(tid)?
  return done

flow ApplyDurableMigration text -> Result<text>
  in migrations: MigrationRunner = DurableSqliteMigrations
  call version = migrations.up(input)?
  return version

flow RollbackDurableMigration text -> Result<text>
  in migrations: MigrationRunner = DurableSqliteMigrations
  call version = migrations.down(input)?
  return version

flow DurableMigrationStatus unit -> Result<text>
  in migrations: MigrationRunner = DurableSqliteMigrations
  call version = migrations.status(input)?
  return version

flow ApplyMigration text -> Result<text>
  in migrations: MigrationRunner = MemoryMigrations
  call version = migrations.up(input)?
  return version

flow RollbackMigration text -> Result<text>
  in migrations: MigrationRunner = MemoryMigrations
  call version = migrations.down(input)?
  return version

flow MigrationStatus unit -> Result<text>
  in migrations: MigrationRunner = MemoryMigrations
  call version = migrations.status(input)?
  return version

flow ValidateAndStoreMovement Movement -> Result<Movement>
  in store: MovementStore = MemoryMovements
  run valid = ValidateMovement(input)?
  call saved = store.save(valid)?
  return saved

flow TagMovementPersisted Movement -> Result<text>
  in log: EventLog = MemoryEventLog
  call tagged = log.append("persisted")?
  return tagged

flow TagMovementAnnounced Movement -> Result<text>
  in log: EventLog = MemoryEventLog
  call tagged = log.append("announced")?
  return tagged

flow SaveAndAnnounce Movement -> Result<Movement>
  in store: MovementStore = MemoryMovements
  call saved = store.save(input)?
  emit MovementSaved(saved)
  return saved

flow ListMovementTags unit -> Result<List<text>>
  in log: EventLog = MemoryEventLog
  call tags = log.list(input)?
  return tags

flow RecordJobTick unit -> Result<text>
  in log: EventLog = MemoryEventLog
  call tagged = log.append("job-tick")?
  return tagged

flow ScheduleMovementPersist Movement -> Result<Movement>
  enqueue PersistMovementJob(input)
  return input

flow ScheduleDurableMovementPersist Movement -> Result<Movement>
  enqueue DurablePersistMovementJob(input)
  return input

flow CacheBalanceSnapshot CacheEntry -> Result<text>
  in cache: Cache = MemoryCache
  call stored = cache.put(input)?
  call loaded = cache.get(input.key)?
  return loaded

flow LoadCachedBalance text -> Result<text>
  in cache: Cache = MemoryCache
  call loaded = cache.get(input)?
  return loaded

flow InvalidateCachedBalance text -> Result<bool>
  in cache: Cache = MemoryCache
  call removed = cache.invalidate(input)?
  return removed

flow CacheBalanceSnapshotDurable CacheEntry -> Result<text>
  in cache: Cache = DurableCache
  call stored = cache.put(input)?
  call loaded = cache.get(input.key)?
  return loaded

flow LoadCachedBalanceDurable text -> Result<text>
  in cache: Cache = DurableCache
  call loaded = cache.get(input)?
  return loaded

flow InvalidateCachedBalanceDurable text -> Result<bool>
  in cache: Cache = DurableCache
  call removed = cache.invalidate(input)?
  return removed

flow WriteObservabilityLog text -> Result<unit>
  in logger: Logger = MemoryLogger
  call written = logger.write(input)?
  return written

flow ListObservabilityLogs unit -> Result<List<text>>
  in logger: Logger = MemoryLogger
  call lines = logger.list(input)?
  return lines

flow RecordTwoObservabilityLines unit -> Result<List<text>>
  in logger: Logger = MemoryLogger
  call first = logger.write("ledger.balance")?
  call second = logger.write("ledger.balance")?
  call lines = logger.list(input)?
  return lines

flow IncrementObservabilityMetric text -> Result<int>
  in metrics: Metrics = MemoryMetrics
  call value = metrics.increment(input)?
  return value

flow GetObservabilityMetric text -> Result<int>
  in metrics: Metrics = MemoryMetrics
  call value = metrics.get(input)?
  return value

flow ObserveMetricTwice unit -> Result<int>
  in metrics: Metrics = MemoryMetrics
  call first = metrics.increment("ledger.balance")?
  call second = metrics.increment("ledger.balance")?
  call value = metrics.get("ledger.balance")?
  return value

flow StartObservabilitySpan text -> Result<text>
  in tracer: Tracer = MemoryTracer
  call span = tracer.start(input)?
  return span

flow FinishObservabilitySpan text -> Result<unit>
  in tracer: Tracer = MemoryTracer
  call done = tracer.finish(input)?
  return done

flow ListObservabilitySpans unit -> Result<List<text>>
  in tracer: Tracer = MemoryTracer
  call spans = tracer.list(input)?
  return spans

flow TraceObservabilitySpan unit -> Result<List<text>>
  in tracer: Tracer = MemoryTracer
  call span = tracer.start("CalculateLedgerBalance")?
  call done = tracer.finish(span)?
  call spans = tracer.list(input)?
  return spans

flow ProbeRateLimit text -> Result<bool>
  in limiter: RateLimit = MemoryRateLimit
  call allowed = limiter.allow(input)?
  return allowed

flow FindMovement uuid -> Result<Movement>
  in store: MovementStore = MemoryMovements
  call found = store.find(input)?
  return found

flow FindMovementResilient uuid -> Result<Movement>
  in store: MovementStore = MemoryMovements
  attempt found = store.find(input)?
    retry = 2
    timeout_ms = 250
  return found

flow FindFirstMovement MovementLookupBatch -> Result<Movement>
  race found: Movement = input.ids as candidate
    run = FindMovement(candidate)?
  return found

flow PreviewMovement MovementPreviewRequest -> Result<Movement>
  run valid = ValidateMovement(input.movement)?
  return valid

flow EchoText text -> text
  return input

flow PreviewWithClientSession ClientSessionRequest -> Result<Movement>
  run valid = ValidateMovement(input.movement)?
  return valid

api CashflowApi
  post /movements Movement -> Result<Movement> = ValidateAndStoreMovement
  post /movement-by-id uuid -> Result<Movement> = FindMovement
  post /balance MovementBatch -> money = CalculateLedgerBalance
  post /income-amounts MovementBatch -> List<money> = IncomeAmounts
  post /movements/sorted MovementBatch -> List<Movement> = SortMovementsNewest
  post /movements/grouped MovementBatch -> Map<text,List<Movement>> = GroupMovementsByCategory
  get /categories unit -> List<text> = DefaultCategories
  post /movement-views MovementBatch -> List<MovementView> = BuildMovementViewsParallel
  post /movement-by-id/resilient uuid -> Result<Movement> = FindMovementResilient
  post /movement-first MovementLookupBatch -> Result<Movement> = FindFirstMovement
  post /movements/durable Movement -> Result<Movement> = SaveDurableMovement
  post /movement-by-id/durable uuid -> Result<Movement> = FindDurableMovement
  post /movements/query MovementQuery -> Result<MovementPage> = QueryDurableMovements
  post /cache/balance CacheEntry -> Result<text> = CacheBalanceSnapshot
  post /cache/balance/get text -> Result<text> = LoadCachedBalance
  post /cache/balance/invalidate text -> Result<bool> = InvalidateCachedBalance
  post /observability/log text -> Result<unit> = WriteObservabilityLog
  post /observability/logs unit -> Result<List<text>> = ListObservabilityLogs
  post /observability/metrics/increment text -> Result<int> = IncrementObservabilityMetric
  post /observability/metrics/get text -> Result<int> = GetObservabilityMetric
  post /observability/trace text -> Result<text> = StartObservabilitySpan
  post /observability/trace/finish text -> Result<unit> = FinishObservabilitySpan
  post /observability/spans unit -> Result<List<text>> = ListObservabilitySpans
  get /movements/{id} uuid -> Result<Movement> = FindDurableMovement from path.id
  get /movements/find uuid -> Result<Movement> = FindDurableMovement from query.id
  get /me text -> text = EchoText from header.x-user
  get /session text -> text = EchoText from cookie.sid
  post /accounts/{account}/movement-preview MovementPreviewRequest -> Result<Movement> = PreviewMovement
    bind account = path.account
    bind movement = body
    bind dry_run = query.dry_run
  post /client-preview ClientSessionRequest -> Result<Movement> = PreviewWithClientSession
    bind user = header.x-user
    bind sid = cookie.sid
    bind movement = body

api SecuredCashflowApi
  auth bearer: HttpAuth = CashflowDemoBearer
  post /secure/balance MovementBatch -> money = CalculateLedgerBalance

api JwtSecuredCashflowApi
  auth bearer: HttpAuth = CashflowDemoJwt
  post /jwt/balance MovementBatch -> money = CalculateLedgerBalance

api GuardedCashflowApi
  middleware request: HttpMiddleware = CashflowClientGate
  post /guarded/balance MovementBatch -> money = CalculateLedgerBalance

api AnnotatedCashflowApi
  middleware response: HttpResponseMiddleware = CashflowResponseHeaders
  post /annotated/balance MovementBatch -> money = CalculateLedgerBalance

api LimitedCashflowApi
  middleware request: RateLimit = MemoryRateLimit
  post /limited/balance MovementBatch -> money = CalculateLedgerBalance

api CorsCashflowApi
  middleware request: HttpMiddleware = CashflowCorsOrigin
  middleware response: HttpResponseMiddleware = CashflowCorsHeaders
  post /cors/balance MovementBatch -> money = CalculateLedgerBalance
