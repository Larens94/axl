// OAuth boundary sample — capacity shape and demo provider.
// Check succeeds (syntax/types). Runtime uses rust::axl::auth::oauth:
// - authorize_url(state) → provider authorize URL with query params
// - exchange(code) → JSON OAuthToken text (demo codes: axl-demo-{16 hex})
//
// Future ABI (steward queue):
// - Types: OAuthStart { provider, redirect_uri, state }, OAuthCode { code, state },
//   OAuthToken { access_token, token_type, expires_in, refresh_token?, sub? }
// - HTTP redirect + callback route; AXL flow maps token → Sessione
axl 4
app OAuthBoundary

capacity OAuthClient
  op authorize_url text -> Result<text> idempotent
  op exchange text -> Result<text>

skill DemoOAuthProvider provides OAuthClient
  native rust axl::auth::oauth
  config client_id: text = secret("AXL_OAUTH_CLIENT_ID")
  config client_secret: text = secret("AXL_OAUTH_CLIENT_SECRET")
  config authorize_url: text = "https://example.invalid/oauth/authorize"
  config token_url: text = "https://example.invalid/oauth/token"
  config redirect_uri: text = "https://portal.example.invalid/oauth/callback"
  capability auth.oauth

flow OAuthAuthorizeUrlDemo text -> Result<text>
  in oauth: OAuthClient = DemoOAuthProvider
  call url = oauth.authorize_url(input)?
  return url

flow OAuthExchangeDemo text -> Result<text>
  in oauth: OAuthClient = DemoOAuthProvider
  call token = oauth.exchange(input)?
  return token
