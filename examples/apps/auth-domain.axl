flow LogoutUtente uuid -> Result<Sessione>
  in sessioni: ArchivioSessioni = MemoriaSessioni
  call sessione = sessioni.find(input)?
  make spenta: Sessione
    id = sessione.id
    utente_id = sessione.utente_id
    attiva = false
  call spenta_salvata = sessioni.save(spenta)?
  return spenta_salvata

flow UtenteIdDaAuthorization text -> Result<uuid>
  in decoder: JwtDecoder = AuthDemoJwtDecoder
  call claims = decoder.decode(input)?
  return claims.sub

flow VerificaAuthorization BearerAuthInput -> Result<uuid>
  run utente_id = UtenteIdDaAuthorization(input.authorization)?
  make check: PermessoCheck
    utente_id = utente_id
    codice = input.permesso
  run _ = RichiediPermesso(check)?
  return utente_id

flow LoginAdminDemoUnit unit -> Result<LoginResult>
  in utenti: ArchivioUtenti = MemoriaUtenti
  run _seed = SeedUtentiDemo(input)?
  make credenziali: LoginInput
    email = "admin@example.com"
    password = "admin123"
  run login = LoginUtente(credenziali)?
  return login

flow LoginVenditoreDemoUnit unit -> Result<LoginResult>
  in utenti: ArchivioUtenti = MemoriaUtenti
  run _seed = SeedUtentiDemo(input)?
  make credenziali: LoginInput
    email = "venditore@example.com"
    password = "vend123"
  run login = LoginUtente(credenziali)?
  return login

flow UtenteHaPermessoDemoUnit unit -> Result<bool>
  run _seed = SeedUtentiDemo(input)?
  make check_admin: PermessoCheck
    utente_id = "utente-admin"
    codice = "admin.ruoli.write"
  run admin_ok = UtenteHaPermesso(check_admin)?
  make check_vend: PermessoCheck
    utente_id = "utente-venditore"
    codice = "admin.ruoli.write"
  run vend_negato = UtenteHaPermesso(check_vend)?
  let ok = admin_ok && !vend_negato
  require ok else "rbac_seed_non_coerente"
  return admin_ok

flow CreaRuoloDinamicoDemoUnit unit -> Result<Ruolo>
  run _init = InizializzaAuthDemo(input)?
  make nuovo: CreaRuoloInput
    nome = "supporto"
    descrizione = "Supporto clienti"
  run ruolo = CreaRuolo(nuovo)?
  make assegna: AssegnaPermessoInput
    ruolo_id = ruolo.id
    permesso_codice = "vendite.clienti.read"
  run aggiornato = AssegnaPermessoARuolo(assegna)?
  fold primo: text = aggiornato.permessi from "" as codice
    next = if value != "" then value else codice
  let dinamico = primo == "vendite.clienti.read"
  require dinamico else "ruolo_dinamico_non_aggiornato"
  return aggiornato

flow ResetPasswordDemoUnit unit -> Result<Utente>
  in utenti: ArchivioUtenti = MemoriaUtenti
  in mailer: EmailSender = MemoriaEmail
  run _seed = SeedUtentiDemo(input)?
  make richiesta: RichiestaResetPasswordInput
    email = "admin@example.com"
  run _reset_req = RichiediResetPassword(richiesta)?
  call mail = mailer.latest(input)?
  make reimposta: ReimpostaPasswordInput
    token = mail.body
    password = "nuova-admin-123"
    password_conferma = "nuova-admin-123"
  run aggiornato = ReimpostaPassword(reimposta)?
  make login: LoginInput
    email = "admin@example.com"
    password = "nuova-admin-123"
  run _login = LoginUtente(login)?
  return aggiornato

flow RichiediResetPasswordMessaggioDemoUnit unit -> Result<ResetPasswordResult>
  run _seed = SeedUtentiDemo(input)?
  make richiesta: RichiestaResetPasswordInput
    email = "admin@example.com"
  run result = RichiediResetPassword(richiesta)?
  return result
