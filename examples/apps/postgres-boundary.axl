// PostgreSQL boundary sample — store, transactions and migrations.
// Runtime: rust::axl::store::postgres, axl::tx::postgres, axl::migrate::postgres
// Set AXL_POSTGRES_URL before eval (e.g. postgresql://user:pass@localhost/axl_test).
axl 4
app PostgresBoundary

entity Record
  id: uuid required
  kind: text required
  account: text required
  occurred_at: text required

entity RecordQuery
  filter: Map<text,text> optional
  order_by: text optional
  direction: text optional
  limit: int optional
  offset: int optional

entity RecordPage
  items: List<Record> required
  total: int required
  limit: int required
  offset: int required

entity RecordPair
  first: Record required
  second: Record required

capacity RecordStore
  op save Record -> Result<Record>
  op find uuid -> Result<Record> idempotent
  op query RecordQuery -> Result<RecordPage> idempotent

capacity TransactionManager
  op begin text -> Result<text>
  op commit text -> Result<unit>
  op rollback text -> Result<unit>

capacity MigrationRunner
  op up text -> Result<text>
  op down text -> Result<text>
  op status unit -> Result<text>

skill PostgresRecords provides RecordStore
  native rust axl::store::postgres
  config url: text = secret("AXL_POSTGRES_URL")
  effect db.read
  effect db.write
  capability storage.postgres

skill PostgresTransactions provides TransactionManager
  native rust axl::tx::postgres
  config url: text = secret("AXL_POSTGRES_URL")
  effect db.write
  capability storage.postgres

skill PostgresMigrations provides MigrationRunner
  native rust axl::migrate::postgres
  config url: text = secret("AXL_POSTGRES_URL")
  effect db.write
  capability storage.postgres

flow PostgresSaveDemo Record -> Result<Record>
  in store: RecordStore = PostgresRecords
  call saved = store.save(input)?
  return saved

flow PostgresFindDemo uuid -> Result<Record>
  in store: RecordStore = PostgresRecords
  call found = store.find(input)?
  return found

flow PostgresQueryDemo RecordQuery -> Result<RecordPage>
  in store: RecordStore = PostgresRecords
  call page = store.query(input)?
  return page

flow PostgresTxCommitDemo RecordPair -> Result<Record>
  in tx: TransactionManager = PostgresTransactions
  in store: RecordStore = PostgresRecords
  call tid = tx.begin("pg-commit")?
  call first = store.save(input.first)?
  call second = store.save(input.second)?
  call done = tx.commit(tid)?
  return second

flow PostgresTxRollbackDemo RecordPair -> Result<unit>
  in tx: TransactionManager = PostgresTransactions
  in store: RecordStore = PostgresRecords
  call tid = tx.begin("pg-rollback")?
  call first = store.save(input.first)?
  call second = store.save(input.second)?
  call done = tx.rollback(tid)?
  return done

flow PostgresMigrateUpDemo text -> Result<text>
  in migrations: MigrationRunner = PostgresMigrations
  call version = migrations.up(input)?
  return version

flow PostgresMigrateDownDemo text -> Result<text>
  in migrations: MigrationRunner = PostgresMigrations
  call version = migrations.down(input)?
  return version

flow PostgresMigrateStatusDemo unit -> Result<text>
  in migrations: MigrationRunner = PostgresMigrations
  call version = migrations.status(input)?
  return version
