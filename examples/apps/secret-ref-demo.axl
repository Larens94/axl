// Gate 8 secret references: values resolve from the environment at runtime.
axl 4
app SecretRefDemo

capacity PasswordHasher
  op hash text -> Result<text>
  op verify PasswordCheck -> Result<bool> idempotent

entity PasswordCheck
  password: text required
  hash: text required

skill EnvPepperHasher provides PasswordHasher
  native rust axl::auth::password
  config pepper: text = secret("AXL_AUTH_PEPPER")
  capability auth.hash

flow HashDemo text -> Result<text>
  in hasher: PasswordHasher = EnvPepperHasher
  call hash = hasher.hash(input)?
  return hash
