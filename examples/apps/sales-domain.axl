// Sales domain: Cliente entity, store capacity and CRUD flows.
axl 4
app SalesDomain

enum ClienteStato
  attivo
  inattivo

entity Cliente
  id: uuid key
  nome: text required
  email: email required
  budget: money required
  priorita: int optional
  stato: ClienteStato required

entity ClienteQuery
  filter: Map<text,text> optional
  order_by: text optional
  direction: text optional
  limit: int optional
  offset: int optional

entity ClientePage
  items: List<Cliente> required
  total: int required
  limit: int required
  offset: int required

capacity ArchivioClienti
  op save Cliente -> Result<Cliente>
  op find uuid -> Result<Cliente> idempotent
  op list unit -> Result<List<Cliente>> idempotent
  op query ClienteQuery -> Result<ClientePage> idempotent

skill MemoriaClienti provides ArchivioClienti
  native rust axl::store::memory
  effect db.read
  effect db.write

skill SqliteClienti provides ArchivioClienti
  native rust axl::store::sqlite
  config path: text = "./build/vendite.db"
  effect db.read
  effect db.write

flow ValidaCliente Cliente -> Result<Cliente>
  let nome_presente = input.nome != ""
  require nome_presente else "nome_obbligatorio"
  let budget_positivo = input.budget > 0
  require budget_positivo else "budget_deve_essere_positivo"
  return input

flow CreaCliente Cliente -> Result<Cliente>
  in store: ArchivioClienti = MemoriaClienti
  run valida = ValidaCliente(input)?
  call salvato = store.save(valida)?
  return salvato

flow CercaCliente uuid -> Result<Cliente>
  in store: ArchivioClienti = MemoriaClienti
  call trovato = store.find(input)?
  return trovato

flow ElencaClienti unit -> Result<List<Cliente>>
  in store: ArchivioClienti = MemoriaClienti
  call clienti = store.list(input)?
  return clienti

flow InterrogaClienti ClienteQuery -> Result<ClientePage>
  in store: ArchivioClienti = MemoriaClienti
  call pagina = store.query(input)?
  return pagina

flow CercaClientiAttivi ClienteQuery -> Result<ClientePage>
  run pagina = InterrogaClienti(input)?
  return pagina

flow CercaClientiAttiviDemoUnit ClienteQuery -> Result<ClientePage>
  in store: ArchivioClienti = MemoriaClienti
  make cliente1: Cliente
    id = "cliente-001"
    nome = "Alice Rossi"
    email = "alice@example.com"
    budget = 250000
    priorita = 1
    stato = ClienteStato.attivo
  make cliente2: Cliente
    id = "cliente-002"
    nome = "Bob Bianchi"
    email = "bob@example.com"
    budget = 180000
    stato = ClienteStato.inattivo
  run valida1 = ValidaCliente(cliente1)?
  call c1 = store.save(valida1)?
  run valida2 = ValidaCliente(cliente2)?
  call c2 = store.save(valida2)?
  run pagina = CercaClientiAttivi(input)?
  return pagina

flow PaginaClientiDemoUnit unit -> Result<ClientePage>
  in store: ArchivioClienti = MemoriaClienti
  make cliente1: Cliente
    id = "cliente-001"
    nome = "Alice Rossi"
    email = "alice@example.com"
    budget = 250000
    priorita = 1
    stato = ClienteStato.attivo
  make cliente2: Cliente
    id = "cliente-002"
    nome = "Bob Bianchi"
    email = "bob@example.com"
    budget = 180000
    stato = ClienteStato.attivo
  run valida1 = ValidaCliente(cliente1)?
  call c1 = store.save(valida1)?
  run valida2 = ValidaCliente(cliente2)?
  call c2 = store.save(valida2)?
  make query: ClienteQuery
    order_by = "nome"
    direction = "asc"
    limit = 10
    offset = 0
  call pagina = store.query(query)?
  return pagina

entity Prodotto
  id: uuid key
  nome: text required
  prezzo: money required
  sku: text required
  attivo: bool optional

entity ProdottoQuery
  filter: Map<text,text> optional
  order_by: text optional
  direction: text optional
  limit: int optional
  offset: int optional

entity ProdottoPage
  items: List<Prodotto> required
  total: int required
  limit: int required
  offset: int required

capacity ArchivioProdotti
  op save Prodotto -> Result<Prodotto>
  op find uuid -> Result<Prodotto> idempotent
  op list unit -> Result<List<Prodotto>> idempotent
  op query ProdottoQuery -> Result<ProdottoPage> idempotent

skill MemoriaProdotti provides ArchivioProdotti
  native rust axl::store::memory
  effect db.read
  effect db.write

skill SqliteProdotti provides ArchivioProdotti
  native rust axl::store::sqlite
  config path: text = "./build/vendite.db"
  effect db.read
  effect db.write

flow ValidaProdotto Prodotto -> Result<Prodotto>
  let nome_presente = input.nome != ""
  require nome_presente else "nome_obbligatorio"
  let prezzo_positivo = input.prezzo > 0
  require prezzo_positivo else "prezzo_deve_essere_positivo"
  let sku_presente = input.sku != ""
  require sku_presente else "sku_obbligatorio"
  return input

flow CreaProdotto Prodotto -> Result<Prodotto>
  in store: ArchivioProdotti = MemoriaProdotti
  run valida = ValidaProdotto(input)?
  call salvato = store.save(valida)?
  return salvato

flow CercaProdotto uuid -> Result<Prodotto>
  in store: ArchivioProdotti = MemoriaProdotti
  call trovato = store.find(input)?
  return trovato

flow ElencaProdotti unit -> Result<List<Prodotto>>
  in store: ArchivioProdotti = MemoriaProdotti
  call prodotti = store.list(input)?
  return prodotti

flow InterrogaProdotti ProdottoQuery -> Result<ProdottoPage>
  in store: ArchivioProdotti = MemoriaProdotti
  call pagina = store.query(input)?
  return pagina

flow CercaProdottiPerSku ProdottoQuery -> Result<ProdottoPage>
  run pagina = InterrogaProdotti(input)?
  return pagina

flow CercaProdottiPerSkuDemoUnit ProdottoQuery -> Result<ProdottoPage>
  in store: ArchivioProdotti = MemoriaProdotti
  make prodotto1: Prodotto
    id = "prodotto-001"
    nome = "Laptop Pro"
    prezzo = 129900
    sku = "LP-001"
    attivo = true
  make prodotto2: Prodotto
    id = "prodotto-002"
    nome = "Mouse wireless"
    prezzo = 2990
    sku = "MS-002"
    attivo = true
  run valida1 = ValidaProdotto(prodotto1)?
  call p1 = store.save(valida1)?
  run valida2 = ValidaProdotto(prodotto2)?
  call p2 = store.save(valida2)?
  run pagina = CercaProdottiPerSku(input)?
  return pagina

flow PaginaProdottiDemoUnit unit -> Result<ProdottoPage>
  in store: ArchivioProdotti = MemoriaProdotti
  make prodotto1: Prodotto
    id = "prodotto-001"
    nome = "Laptop Pro"
    prezzo = 129900
    sku = "LP-001"
    attivo = true
  make prodotto2: Prodotto
    id = "prodotto-002"
    nome = "Mouse wireless"
    prezzo = 2990
    sku = "MS-002"
    attivo = true
  run valida1 = ValidaProdotto(prodotto1)?
  call p1 = store.save(valida1)?
  run valida2 = ValidaProdotto(prodotto2)?
  call p2 = store.save(valida2)?
  make query: ProdottoQuery
    order_by = "nome"
    direction = "asc"
    limit = 10
    offset = 0
  call pagina = store.query(query)?
  return pagina

enum StatoPreventivo
  bozza
  inviato
  confermato

entity RigaPreventivo
  prodotto_id: uuid required
  quantita: int required
  prezzo_unitario: money required
  importo: money required

entity Preventivo
  id: uuid key
  cliente_id: uuid required
  stato: StatoPreventivo required
  righe: List<RigaPreventivo> required
  totale: money required

entity PreventivoQuery
  filter: Map<text,text> optional
  order_by: text optional
  direction: text optional
  limit: int optional
  offset: int optional

entity PreventivoPage
  items: List<Preventivo> required
  total: int required
  limit: int required
  offset: int required

capacity ArchivioPreventivi
  op save Preventivo -> Result<Preventivo>
  op find uuid -> Result<Preventivo> idempotent
  op list unit -> Result<List<Preventivo>> idempotent
  op query PreventivoQuery -> Result<PreventivoPage> idempotent

skill MemoriaPreventivi provides ArchivioPreventivi
  native rust axl::store::memory
  effect db.read
  effect db.write

skill SqlitePreventivi provides ArchivioPreventivi
  native rust axl::store::sqlite
  config path: text = "./build/vendite.db"
  effect db.read
  effect db.write

flow ValidaRigaPreventivo RigaPreventivo -> Result<RigaPreventivo>
  let quantita_positiva = input.quantita > 0
  require quantita_positiva else "quantita_deve_essere_positiva"
  let prezzo_positivo = input.prezzo_unitario > 0
  require prezzo_positivo else "prezzo_deve_essere_positivo"
  let importo_calcolato = input.quantita * input.prezzo_unitario
  make riga: RigaPreventivo
    prodotto_id = input.prodotto_id
    quantita = input.quantita
    prezzo_unitario = input.prezzo_unitario
    importo = importo_calcolato
  return riga

flow CalcolaTotalePreventivo Preventivo -> money
  fold totale: money = input.righe from 0 as riga
    next = value + riga.importo
  return totale

flow ValidaPreventivo Preventivo -> Result<Preventivo>
  parallel righe_valide: List<RigaPreventivo> = input.righe as riga
    run = ValidaRigaPreventivo(riga)?
  make con_righe: Preventivo
    id = input.id
    cliente_id = input.cliente_id
    stato = input.stato
    righe = righe_valide
    totale = 0
  run totale = CalcolaTotalePreventivo(con_righe)
  let totale_positivo = totale > 0
  require totale_positivo else "totale_deve_essere_positivo"
  make preventivo: Preventivo
    id = input.id
    cliente_id = input.cliente_id
    stato = input.stato
    righe = righe_valide
    totale = totale
  return preventivo

flow CreaPreventivo Preventivo -> Result<Preventivo>
  in store: ArchivioPreventivi = MemoriaPreventivi
  run valida = ValidaPreventivo(input)?
  call salvato = store.save(valida)?
  return salvato

flow CercaPreventivo uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = MemoriaPreventivi
  call trovato = store.find(input)?
  return trovato

flow ElencaPreventivi unit -> Result<List<Preventivo>>
  in store: ArchivioPreventivi = MemoriaPreventivi
  call preventivi = store.list(input)?
  return preventivi

flow InterrogaPreventivi PreventivoQuery -> Result<PreventivoPage>
  in store: ArchivioPreventivi = MemoriaPreventivi
  call pagina = store.query(input)?
  return pagina

flow CercaPreventiviPerStato PreventivoQuery -> Result<PreventivoPage>
  run pagina = InterrogaPreventivi(input)?
  return pagina

flow CercaPreventiviPerStatoDemoUnit PreventivoQuery -> Result<PreventivoPage>
  in store: ArchivioPreventivi = MemoriaPreventivi
  make riga_bozza: RigaPreventivo
    prodotto_id = "prodotto-001"
    quantita = 1
    prezzo_unitario = 129900
    importo = 129900
  make preventivo_bozza: Preventivo
    id = "preventivo-001"
    cliente_id = "cliente-001"
    stato = StatoPreventivo.bozza
    righe = [riga_bozza]
    totale = 129900
  run valida_bozza = ValidaPreventivo(preventivo_bozza)?
  call salvato_bozza = store.save(valida_bozza)?
  make riga_inviato: RigaPreventivo
    prodotto_id = "prodotto-002"
    quantita = 2
    prezzo_unitario = 2990
    importo = 5980
  make preventivo_inviato: Preventivo
    id = "preventivo-002"
    cliente_id = "cliente-002"
    stato = StatoPreventivo.inviato
    righe = [riga_inviato]
    totale = 5980
  run valida_inviato = ValidaPreventivo(preventivo_inviato)?
  call salvato_inviato = store.save(valida_inviato)?
  run pagina = CercaPreventiviPerStato(input)?
  return pagina

flow SeedPreventivoDemoUnit unit -> Result<Preventivo>
  in store: ArchivioPreventivi = MemoriaPreventivi
  make riga1: RigaPreventivo
    prodotto_id = "prodotto-001"
    quantita = 2
    prezzo_unitario = 129900
    importo = 259800
  make riga2: RigaPreventivo
    prodotto_id = "prodotto-002"
    quantita = 3
    prezzo_unitario = 2990
    importo = 8970
  let righe = [riga1, riga2]
  make preventivo: Preventivo
    id = "preventivo-001"
    cliente_id = "cliente-001"
    stato = StatoPreventivo.bozza
    righe = righe
    totale = 268770
  run valida = ValidaPreventivo(preventivo)?
  call salvato = store.save(valida)?
  return salvato

flow PaginaPreventiviDemoUnit unit -> Result<PreventivoPage>
  in store: ArchivioPreventivi = MemoriaPreventivi
  run seed = SeedPreventivoDemoUnit(input)?
  make query: PreventivoQuery
    order_by = "id"
    direction = "asc"
    limit = 10
    offset = 0
  call pagina = store.query(query)?
  return pagina

flow InviaPreventivo uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = MemoriaPreventivi
  call trovato = store.find(input)?
  match stato_inviabile: bool = trovato.stato
    bozza => true
    inviato => false
    confermato => false
  require stato_inviabile else "stato_non_inviabile"
  match nuovo_stato: StatoPreventivo = trovato.stato
    bozza => StatoPreventivo.inviato
    inviato => StatoPreventivo.inviato
    confermato => StatoPreventivo.confermato
  make aggiornato: Preventivo
    id = trovato.id
    cliente_id = trovato.cliente_id
    stato = nuovo_stato
    righe = trovato.righe
    totale = trovato.totale
  run valida = ValidaPreventivo(aggiornato)?
  call salvato = store.save(valida)?
  return salvato

flow ConfermaPreventivo uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = MemoriaPreventivi
  call trovato = store.find(input)?
  match stato_confermable: bool = trovato.stato
    bozza => false
    inviato => true
    confermato => false
  require stato_confermable else "stato_non_confermable"
  match nuovo_stato: StatoPreventivo = trovato.stato
    bozza => StatoPreventivo.bozza
    inviato => StatoPreventivo.confermato
    confermato => StatoPreventivo.confermato
  make aggiornato: Preventivo
    id = trovato.id
    cliente_id = trovato.cliente_id
    stato = nuovo_stato
    righe = trovato.righe
    totale = trovato.totale
  run valida = ValidaPreventivo(aggiornato)?
  call salvato = store.save(valida)?
  return salvato

flow AnnullaPreventivo uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = MemoriaPreventivi
  call trovato = store.find(input)?
  match stato_annullabile: bool = trovato.stato
    bozza => true
    inviato => true
    confermato => false
  require stato_annullabile else "stato_non_annullabile"
  make aggiornato: Preventivo
    id = trovato.id
    cliente_id = trovato.cliente_id
    stato = StatoPreventivo.bozza
    righe = trovato.righe
    totale = trovato.totale
  run valida = ValidaPreventivo(aggiornato)?
  call salvato = store.save(valida)?
  return salvato

flow InviaPreventivoDemoUnit unit -> Result<Preventivo>
  run seed = SeedPreventivoDemoUnit(input)?
  run inviato = InviaPreventivo(seed.id)?
  return inviato

flow ConfermaPreventivoDemoUnit unit -> Result<Preventivo>
  run seed = SeedPreventivoDemoUnit(input)?
  run inviato = InviaPreventivo(seed.id)?
  run confermato = ConfermaPreventivo(seed.id)?
  return confermato

flow AnnullaPreventivoDemoUnit unit -> Result<Preventivo>
  run seed = SeedPreventivoDemoUnit(input)?
  run inviato = InviaPreventivo(seed.id)?
  run annullato = AnnullaPreventivo(seed.id)?
  return annullato

flow InviaPreventivoDoppioDemoUnit unit -> Result<Preventivo>
  run seed = SeedPreventivoDemoUnit(input)?
  run inviato = InviaPreventivo(seed.id)?
  run doppio = InviaPreventivo(seed.id)?
  return doppio

