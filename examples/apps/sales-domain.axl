flow InviaPreventivoSqlite uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = SqlitePreventivi
  call trovato = store.find(input)?
  match stato_inviabile: bool = trovato.stato
    bozza => true
    inviato => false
    confermato => false
  require stato_inviabile else "stato_non_inviabile"
  match nuovo_stato: StatoPreventivo = trovato.stato
    bozza => StatoPreventivo.inviato
    inviato => StatoPreventivo.inviato
    confermato => StatoPreventivo.confermato
  make aggiornato: Preventivo
    id = trovato.id
    cliente_id = trovato.cliente_id
    stato = nuovo_stato
    righe = trovato.righe
    totale = trovato.totale
  run valida = ValidaPreventivo(aggiornato)?
  call salvato = store.save(valida)?
  return salvato

flow ConfermaPreventivoSqlite uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = SqlitePreventivi
  call trovato = store.find(input)?
  match stato_confermable: bool = trovato.stato
    bozza => false
    inviato => true
    confermato => false
  require stato_confermable else "stato_non_confermable"
  match nuovo_stato: StatoPreventivo = trovato.stato
    bozza => StatoPreventivo.bozza
    inviato => StatoPreventivo.confermato
    confermato => StatoPreventivo.confermato
  make aggiornato: Preventivo
    id = trovato.id
    cliente_id = trovato.cliente_id
    stato = nuovo_stato
    righe = trovato.righe
    totale = trovato.totale
  run valida = ValidaPreventivo(aggiornato)?
  call salvato = store.save(valida)?
  return salvato

flow AnnullaPreventivoSqlite uuid -> Result<Preventivo>
  in store: ArchivioPreventivi = SqlitePreventivi
  call trovato = store.find(input)?
  match stato_annullabile: bool = trovato.stato
    bozza => true
    inviato => true
    confermato => false
  require stato_annullabile else "stato_non_annullabile"
  make aggiornato: Preventivo
    id = trovato.id
    cliente_id = trovato.cliente_id
    stato = StatoPreventivo.bozza
    righe = trovato.righe
    totale = trovato.totale
