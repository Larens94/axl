// Portal shell — ledger-style entry: imports, cross-domain API glue, modular api/ui.
axl 4
app Portal
bootstrap BootstrapPortalProd
import "./auth-domain.axl"
import "./base-domain.axl"
import "./sales-domain.axl"
import "./crm-domain.axl"
import "./domains/contatti/contatto.axl"
import "./domains/inventario/articolo.axl"
import "./domains/progetti/task.axl"
import "./domains/contabilita/fattura.axl"
import "./domains/portal/core.axl"
import "./domains/portal/vendite-pages.axl"
import "./domains/portal/crm-pages.axl"
import "./domains/portal/base-pages.axl"
import "./domains/portal/moduli-pages.axl"
import "./domains/portal/prod.axl"
import "./oauth-boundary.axl"

flow PaginaClientiRbac text -> Result<ClientePage>
  make auth: BearerAuthInput
    authorization = input
    permesso = "vendite.clienti.read"
  run _uid = VerificaAuthorization(auth)?
  in store: ArchivioClienti = MemoriaClienti
  make query: ClienteQuery
    order_by = "nome"
    direction = "asc"
    limit = 10
    offset = 0
  call pagina = store.query(query)?
  return pagina

flow BootstrapPortal unit -> Result<HomePage>
  run result = BootstrapPortalProd(input)?
  return result

api AuthApi
  post /auth/register RegistrazioneInput -> Result<Utente> = RegistraPortal
  post /auth/login LoginInput -> Result<LoginResult> = LoginPortal
  post /auth/logout uuid -> Result<Sessione> = LogoutPortal from cookie.sid
    guard session RequireSession from cookie.sid
  post /auth/password/reset-request RichiestaResetPasswordInput -> Result<ResetPasswordResult> = RichiediResetPassword
  post /auth/password/reset ReimpostaPasswordInput -> Result<Utente> = ReimpostaPassword
  get /auth/home unit -> Result<HomePage> = PaginaHome
  post /auth/init-demo unit -> Result<UtentePage> = InizializzaPortal
  post /auth/bootstrap unit -> Result<HomePage> = BootstrapPortalProd
  get /auth/oauth/start unit -> redirect text = OAuthStartPortal
  get /auth/oauth/callback OAuthCallbackInput -> redirect LoginResult = OAuthCallbackPortal
    bind code = query.code
    bind state = query.state
  get /auth/admin/utenti unit -> Result<UtentePage> = PaginaUtentiAdminSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "admin.utenti.read" from cookie.sid
  get /auth/admin/ruoli unit -> Result<RuoloPage> = PaginaRuoliAdminSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "admin.ruoli.read" from cookie.sid
  get /auth/admin/permessi unit -> Result<PermessoPage> = PaginaPermessiAdminSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "admin.permessi.read" from cookie.sid
  post /auth/admin/ruoli CreaRuoloInput -> Result<Ruolo> = CreaRuoloPortal
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "admin.ruoli.write" from cookie.sid
  post /auth/admin/ruoli/permesso AssegnaPermessoInput -> Result<Ruolo> = AssegnaPermessoARuolo
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "admin.ruoli.write" from cookie.sid
  post /auth/admin/utenti/ruolo AssegnaRuoloInput -> Result<Utente> = AssegnaRuoloUtente
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "admin.ruoli.write" from cookie.sid

api VenditeApi
  post /clienti Cliente -> Result<Cliente> = CreaClienteSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.clienti.read" from cookie.sid
  get /clienti/{id} uuid -> Result<Cliente> = CercaClienteSqlite from path.id
  get /clienti unit -> Result<List<Cliente>> = ElencaClientiSqlite
  post /clienti/query ClienteQuery -> Result<ClientePage> = InterrogaClientiSqlite
  post /clienti/search ClienteQuery -> Result<ClientePage> = CercaClientiAttiviSqlite
  post /prodotti Prodotto -> Result<Prodotto> = CreaProdottoSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.prodotti.read" from cookie.sid
  get /prodotti/{id} uuid -> Result<Prodotto> = CercaProdottoSqlite from path.id
  get /prodotti unit -> Result<List<Prodotto>> = ElencaProdottiSqlite
  post /prodotti/query ProdottoQuery -> Result<ProdottoPage> = InterrogaProdottiSqlite
  post /prodotti/search ProdottoQuery -> Result<ProdottoPage> = CercaProdottiPerSkuSqlite
  post /listini Listino -> Result<Listino> = CreaListinoSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.listini.read" from cookie.sid
  get /listini/{id} uuid -> Result<Listino> = CercaListinoSqlite from path.id
  get /listini unit -> Result<List<Listino>> = ElencaListiniSqlite
  post /listini/query ListinoQuery -> Result<ListinoPage> = InterrogaListiniSqlite
  post /listini/prezzo PrezzoListinoQuery -> Result<money> = RisolviPrezzoSqlite
  post /preventivi/con-listino PreventivoConListinoInput -> Result<Preventivo> = CreaPreventivoConListinoSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.preventivi.write" from cookie.sid
  post /preventivi/listino-form PreventivoListinoForm -> Result<Preventivo> = CreaPreventivoListinoFormSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.preventivi.write" from cookie.sid
  post /preventivi Preventivo -> Result<Preventivo> = CreaPreventivoSqlite
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.preventivi.write" from cookie.sid
  get /preventivi/{id} uuid -> Result<Preventivo> = CercaPreventivoSqlite from path.id
  get /preventivi unit -> Result<List<Preventivo>> = ElencaPreventiviSqlite
  post /preventivi/query PreventivoQuery -> Result<PreventivoPage> = InterrogaPreventiviSqlite
  post /preventivi/search PreventivoQuery -> Result<PreventivoPage> = CercaPreventiviPerStatoSqlite
  post /preventivi/{id}/invia uuid -> Result<Preventivo> = InviaPreventivoSqlite from path.id
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.preventivi.write" from cookie.sid
  post /preventivi/{id}/conferma uuid -> Result<Preventivo> = ConfermaPreventivoSqlite from path.id
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.preventivi.write" from cookie.sid
  post /preventivi/{id}/annulla uuid -> Result<Preventivo> = AnnullaPreventivoSqlite from path.id
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.preventivi.write" from cookie.sid
  post /ordini/da-preventivo/{id} uuid -> Result<Ordine> = CreaOrdineDaPreventivoSqlite from path.id
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.ordini.read" from cookie.sid
  get /ordini/{id} uuid -> Result<Ordine> = CercaOrdineSqlite from path.id
  get /ordini unit -> Result<List<Ordine>> = ElencaOrdiniSqlite
  post /ordini/query OrdineQuery -> Result<OrdinePage> = InterrogaOrdiniSqlite
  post /ordini/{id}/conferma uuid -> Result<Ordine> = ConfermaOrdineSqlite from path.id
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.ordini.read" from cookie.sid
  post /ordini/{id}/annulla uuid -> Result<Ordine> = AnnullaOrdineSqlite from path.id
    guard session RequireSession from cookie.sid
    guard can RequireSessionPermesso "vendite.ordini.read" from cookie.sid

api VenditeDurableApi
  post /clienti/durable Cliente -> Result<Cliente> = CreaClienteSqlite
  get /clienti/durable/{id} uuid -> Result<Cliente> = CercaClienteSqlite from path.id
  post /clienti/durable/query ClienteQuery -> Result<ClientePage> = InterrogaClientiSqlite
  post /prodotti/durable Prodotto -> Result<Prodotto> = CreaProdottoSqlite
  get /prodotti/durable/{id} uuid -> Result<Prodotto> = CercaProdottoSqlite from path.id
  post /prodotti/durable/query ProdottoQuery -> Result<ProdottoPage> = InterrogaProdottiSqlite
  post /listini/durable Listino -> Result<Listino> = CreaListinoSqlite
  get /listini/durable/{id} uuid -> Result<Listino> = CercaListinoSqlite from path.id
  post /listini/durable/query ListinoQuery -> Result<ListinoPage> = InterrogaListiniSqlite
  post /listini/durable/prezzo PrezzoListinoQuery -> Result<money> = RisolviPrezzoSqlite
  post /preventivi/durable Preventivo -> Result<Preventivo> = CreaPreventivoSqlite
  get /preventivi/durable/{id} uuid -> Result<Preventivo> = CercaPreventivoSqlite from path.id
  post /preventivi/durable/query PreventivoQuery -> Result<PreventivoPage> = InterrogaPreventiviSqlite
  post /preventivi/durable/{id}/invia uuid -> Result<Preventivo> = InviaPreventivoSqlite from path.id
  post /preventivi/durable/{id}/conferma uuid -> Result<Preventivo> = ConfermaPreventivoSqlite from path.id
  post /preventivi/durable/{id}/annulla uuid -> Result<Preventivo> = AnnullaPreventivoSqlite from path.id
  post /ordini/durable/da-preventivo/{id} uuid -> Result<Ordine> = CreaOrdineDaPreventivoSqlite from path.id
  get /ordini/durable/{id} uuid -> Result<Ordine> = CercaOrdineSqlite from path.id
  post /ordini/durable/query OrdineQuery -> Result<OrdinePage> = InterrogaOrdiniSqlite
  post /ordini/durable/{id}/conferma uuid -> Result<Ordine> = ConfermaOrdineSqlite from path.id
  post /ordini/durable/{id}/annulla uuid -> Result<Ordine> = AnnullaOrdineSqlite from path.id

api PortalDemoApi
  auth bearer: HttpAuth = VenditeDemoBearer
  get /secure/clienti unit -> Result<List<Cliente>> = ElencaClienti
  get /secure/preventivi unit -> Result<List<Preventivo>> = ElencaPreventivi
  get /secure/ordini unit -> Result<List<Ordine>> = ElencaOrdini

api PortalJwtDemoApi
  auth bearer: HttpAuth = VenditeDemoJwt
  get /jwt/preventivi/{id} uuid -> Result<Preventivo> = CercaPreventivo from path.id

api PortalRbacDemoApi
  post /rbac/clienti text -> Result<ClientePage> = PaginaClientiRbac from header.authorization

ui AuthUi
  slot kpi.card = DefaultKpiCard
  slot data.table = DefaultDataTable
  slot shell.sidebar = DefaultSidebar
  slot shell.bottomNav = DefaultBottomNav
  slot state.empty = DefaultEmptyState
  slot state.error = DefaultErrorState
  page / unit -> Result<HomePage> = PaginaHome
    kpi totale_utenti "Utenti registrati" "Totale nel sistema"
  page /home uuid -> Result<HomePage> = PaginaHomeUtentePortal from cookie.sid
    kpi totale_utenti "Utenti registrati" "Totale nel sistema"
  form /login LoginInput -> Result<LoginResult> = LoginPortal submit /auth/login redirect /home
    title "Accedi"
    submit_label "Accedi"
    nav hidden
  form /register RegistrazioneInput -> Result<Utente> = RegistraPortal submit /auth/register redirect /login
    title "Registrati"
    submit_label "Crea account"
    nav hidden
  form /password-dimenticata RichiestaResetPasswordInput -> Result<ResetPasswordResult> = RichiediResetPassword submit /auth/password/reset-request redirect /reimposta-password
    title "Password dimenticata"
    submit_label "Invia link"
    nav hidden
  form /reimposta-password ReimpostaPasswordInput -> Result<Utente> = ReimpostaPassword submit /auth/password/reset redirect /login
    title "Reimposta password"
    submit_label "Aggiorna password"
    nav hidden
  page /admin/utenti uuid -> Result<UtentePage> = PaginaUtentiAdminSessionePortal from cookie.sid
  page /admin/ruoli uuid -> Result<RuoloPage> = PaginaRuoliAdminSessionePortal from cookie.sid
  page /admin/permessi uuid -> Result<PermessoPage> = PaginaPermessiAdminSessionePortal from cookie.sid
  form /admin/ruoli/new CreaRuoloInput -> Result<Ruolo> = CreaRuoloPortal submit /auth/admin/ruoli redirect /admin/ruoli
  action /logout POST /auth/logout redirect /login clear_cookie sid

ui VenditeUi
  page /clienti ClienteSessioneQuery -> Result<ClientePage> = PaginaClientiSessioneQuery
    bind session_id = cookie.sid
    filter stato = query.stato
    pagination limit = query.limit default 10
    pagination offset = query.offset default 0
  form /clienti/new Cliente -> Result<Cliente> = CreaClienteSqlite submit /clienti
    title "Nuovo cliente"
    submit_label "Crea cliente"
    nav hidden
    omit id
  drawer /clienti/{id} uuid -> Result<Cliente> = CercaClienteSqlite from path.id on /clienti
  page /prodotti uuid -> Result<ProdottoPage> = PaginaProdottiSessione from cookie.sid
  form /prodotti/new Prodotto -> Result<Prodotto> = CreaProdottoSqlite submit /prodotti
  page /listini uuid -> Result<ListinoPage> = PaginaListiniSessione from cookie.sid
  page /listini/{id} DettaglioSessioneInput -> Result<Listino> = DettaglioListinoSessione
    bind session_id = cookie.sid
    bind id = path.id
  form /listini/new Listino -> Result<Listino> = CreaListinoSqlite submit /listini
  page /preventivi uuid -> Result<PreventivoPage> = PaginaPreventiviSessione from cookie.sid
  page /preventivi/{id} DettaglioSessioneInput -> Result<Preventivo> = DettaglioPreventivoSessione
    bind session_id = cookie.sid
    bind id = path.id
  form /preventivi/new Preventivo -> Result<Preventivo> = CreaPreventivoSqlite submit /preventivi redirect /preventivi
  form /preventivi/new-listino PreventivoListinoForm -> Result<Preventivo> = CreaPreventivoListinoFormSqlite submit /preventivi/listino-form redirect /preventivi
  action /preventivi/invia POST /preventivi/{id}/invia redirect /preventivi/{id}
  action /preventivi/conferma POST /preventivi/{id}/conferma redirect /preventivi/{id}
  action /preventivi/ordine POST /ordini/da-preventivo/{id} on /preventivi/{id} redirect /ordini/{id}
  page /ordini uuid -> Result<OrdinePage> = PaginaOrdiniSessione from cookie.sid
  page /ordini/{id} DettaglioSessioneInput -> Result<Ordine> = DettaglioOrdineSessione
    bind session_id = cookie.sid
    bind id = path.id
  action /ordini/conferma POST /ordini/{id}/conferma redirect /ordini/{id}
  action /ordini/annulla POST /ordini/{id}/annulla redirect /ordini/{id}

ui VenditeDemoUi
  page /clienti/demo unit -> Result<ClientePage> = PaginaClientiDemoUnit
  drawer /clienti/demo/{id} uuid -> Result<Cliente> = CercaCliente from path.id on /clienti/demo
  page /prodotti/demo unit -> Result<ProdottoPage> = PaginaProdottiDemoUnit
  page /listini/demo unit -> Result<ListinoPage> = PaginaListiniDemoUnit
  page /preventivi/demo unit -> Result<PreventivoPage> = PaginaPreventiviDemoUnit
  page /ordini/demo unit -> Result<OrdinePage> = PaginaOrdiniDemoUnit

api CrmApi
  post /opportunita Opportunita -> Result<Opportunita> = CreaOpportunitaSqlite
    guard session RequireSession from cookie.sid
  get /opportunita/{id} uuid -> Result<Opportunita> = CercaOpportunitaSqlite from path.id
  get /opportunita unit -> Result<List<Opportunita>> = ElencaOpportunita
  post /opportunita/query OpportunitaQuery -> Result<OpportunitaPage> = InterrogaOpportunitaSqlite
  post /opportunita/{id}/avanza uuid -> Result<Opportunita> = AvanzaStadioSqlite from path.id
    guard session RequireSession from cookie.sid

ui CrmUi
  page /crm/pipeline OpportunitaSessioneQuery -> Result<OpportunitaPage> = PaginaPipelineSessione
    bind session_id = cookie.sid
    pagination limit = query.limit default 200
    pagination offset = query.offset default 0
    kanban stadio "Pipeline commerciale"
  page /opportunita OpportunitaSessioneQuery -> Result<OpportunitaPage> = PaginaPipelineSessione
    bind session_id = cookie.sid
    filter stadio = query.stadio
    pagination limit = query.limit default 20
    pagination offset = query.offset default 0
  form /opportunita/new Opportunita -> Result<Opportunita> = CreaOpportunitaSqlite submit /opportunita
    title "Nuova opportunità"
    submit_label "Crea opportunità"
    nav hidden
    omit id
    select cliente from OpzioniContattiSqlite value nome label nome
  drawer /opportunita/{id} uuid -> Result<Opportunita> = CercaOpportunitaSqlite from path.id on /opportunita

ui CrmDemoUi
  page /crm/pipeline/demo unit -> Result<OpportunitaPage> = PaginaOpportunitaDemoUnit
    kanban stadio "Pipeline commerciale (demo)"

api BaseApi
  get /apps/{id} uuid -> Result<Modulo> = CercaModuloSqlite from path.id
  post /apps/query ModuloQuery -> Result<ModuloPage> = InterrogaModuliSqlite
  post /apps/{id}/installa uuid -> Result<Modulo> = InstallaModuloSqlite from path.id
    guard session RequireSession from cookie.sid
  post /apps/{id}/disinstalla uuid -> Result<Modulo> = DisinstallaModuloSqlite from path.id
    guard session RequireSession from cookie.sid

ui BaseUi
  page /apps ModuloSessioneQuery -> Result<ModuloPage> = PaginaAppInstallate
    bind session_id = cookie.sid
    pagination limit = query.limit default 100
    pagination offset = query.offset default 0
    gallery "Le tue app" link rotta
  page /apps/store ModuloSessioneQuery -> Result<ModuloPage> = PaginaAppCatalogo
    bind session_id = cookie.sid
    pagination limit = query.limit default 100
    pagination offset = query.offset default 0
    gallery "App disponibili"
  drawer /apps/dettaglio/{id} uuid -> Result<Modulo> = CercaModuloSqlite from path.id on /apps/store
  action /apps/installa POST /apps/{id}/installa on /apps/dettaglio/{id} redirect /apps/dettaglio/{id}
  action /apps/disinstalla POST /apps/{id}/disinstalla on /apps/dettaglio/{id} redirect /apps/dettaglio/{id}

api ContattiApi
  post /contatti Contatto -> Result<Contatto> = CreaContattoSqlite
    guard session RequireSession from cookie.sid
  get /contatti/{id} uuid -> Result<Contatto> = CercaContattoSqlite from path.id
  post /contatti/query ContattoQuery -> Result<ContattoPage> = InterrogaContattiSqlite

ui ContattiUi
  page /contatti ListaSessioneInput -> Result<ContattoPage> = PaginaContattiSessione
    bind session_id = cookie.sid
    pagination limit = query.limit default 50
    pagination offset = query.offset default 0
    groupby tipo
  form /contatti/new Contatto -> Result<Contatto> = CreaContattoSqlite submit /contatti
    title "Nuovo contatto"
    submit_label "Crea contatto"
    nav hidden
    omit id
  drawer /contatti/{id} uuid -> Result<Contatto> = CercaContattoSqlite from path.id on /contatti

api InventarioApi
  post /inventario Articolo -> Result<Articolo> = CreaArticoloSqlite
    guard session RequireSession from cookie.sid
  get /inventario/{id} uuid -> Result<Articolo> = CercaArticoloSqlite from path.id
  post /inventario/query ArticoloQuery -> Result<ArticoloPage> = InterrogaArticoliSqlite

ui InventarioUi
  page /inventario ListaSessioneInput -> Result<ArticoloPage> = PaginaInventarioSessione
    bind session_id = cookie.sid
    pagination limit = query.limit default 50
    pagination offset = query.offset default 0
    view "Lista" /inventario
    view "Bacheca" /inventario/bacheca
    groupby stato
  page /inventario/bacheca ListaSessioneInput -> Result<ArticoloPage> = PaginaInventarioSessione
    bind session_id = cookie.sid
    pagination limit = query.limit default 200
    pagination offset = query.offset default 0
    view "Lista" /inventario
    view "Bacheca" /inventario/bacheca
    kanban stato "Stato magazzino"
  form /inventario/new Articolo -> Result<Articolo> = CreaArticoloSqlite submit /inventario
    title "Nuovo articolo"
    submit_label "Crea articolo"
    nav hidden
    omit id
  drawer /inventario/{id} uuid -> Result<Articolo> = CercaArticoloSqlite from path.id on /inventario

api ProgettiApi
  post /progetti Task -> Result<Task> = CreaTaskSqlite
    guard session RequireSession from cookie.sid
  get /progetti/{id} uuid -> Result<Task> = CercaTaskSqlite from path.id
  post /progetti/query TaskQuery -> Result<TaskPage> = InterrogaTaskSqlite
  post /progetti/{id}/avanza uuid -> Result<Task> = AvanzaTaskSqlite from path.id
    guard session RequireSession from cookie.sid

ui ProgettiUi
  page /progetti ListaSessioneInput -> Result<TaskPage> = PaginaProgettiSessione
    bind session_id = cookie.sid
    pagination limit = query.limit default 200
    pagination offset = query.offset default 0
    view "Bacheca" /progetti
    view "Elenco" /progetti/lista
    kanban stato "Bacheca attivita"
  page /progetti/lista ListaSessioneInput -> Result<TaskPage> = PaginaProgettiSessione
    bind session_id = cookie.sid
    pagination limit = query.limit default 50
    pagination offset = query.offset default 0
    view "Bacheca" /progetti
    view "Elenco" /progetti/lista
  form /progetti/new Task -> Result<Task> = CreaTaskSqlite submit /progetti
    title "Nuova attivita"
    submit_label "Crea attivita"
    nav hidden
    omit id
  drawer /progetti/dettaglio/{id} uuid -> Result<Task> = CercaTaskSqlite from path.id on /progetti
  action /progetti/avanza POST /progetti/{id}/avanza on /progetti/dettaglio/{id} redirect /progetti/dettaglio/{id}

api ContabilitaApi
  post /contabilita Fattura -> Result<Fattura> = CreaFatturaSqlite
    guard session RequireSession from cookie.sid
  get /contabilita/{id} uuid -> Result<Fattura> = CercaFatturaSqlite from path.id
