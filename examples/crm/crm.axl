// AXL CRM Application Definition
// This file defines the entire CRM application in AXL syntax
// The compiler generates Rust backend + React frontend from this

entity Customer {
  field name: String
  field email: String
  field company: String?
  field phone: String?
  field status: String = "active"
}

entity Lead {
  field company: String
  field contact: String
  field email: String?
  field source: String?
  field status: String = "warm"
  field value: Integer = 0
  field score: Integer = 50
}

entity Deal {
  field name: String
  field customer_id: Integer?
  field value: Integer = 0
  field stage: String = "discovery"
  field probability: Integer = 50
}

entity Activity {
  field date: String?
  field type: String
  field related_type: String?
  field related_id: Integer?
  field description: String?
}

api Customer {
  GET /api/customers → list
  POST /api/customers → create
  GET /api/customers/:id → show
  PUT /api/customers/:id → update
  DELETE /api/customers/:id → delete
}

api Lead {
  GET /api/leads → list
  POST /api/leads → create
  GET /api/leads/:id → show
  PUT /api/leads/:id → update
  DELETE /api/leads/:id → delete
}

api Deal {
  GET /api/deals → list
  POST /api/deals → create
  GET /api/deals/:id → show
  PUT /api/deals/:id → update
  DELETE /api/deals/:id → delete
}

api Activity {
  GET /api/activities → list
  POST /api/activities → create
  GET /api/activities/:id → show
  PUT /api/activities/:id → update
  DELETE /api/activities/:id → delete
}

auth {
  POST /api/auth/login → login
  POST /api/auth/register → register
  middleware: jwt_required
}

ui Dashboard {
  stats: [Customer.count, Lead.count, Deal.count, Deal.revenue]
  table: Customer[name, email, company, status]
}

ui CustomerList {
  columns: [name, email, company, phone, status]
  actions: [edit, delete]
}

ui LeadList {
  columns: [company, contact, email, source, status, value, score]
  actions: [edit, delete]
}

ui DealList {
  columns: [name, customer, value, stage, probability]
  actions: [edit, delete]
}
