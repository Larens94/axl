2;10|db|"/tmp/crm.db",!db_connect/1|s;10|s1|$db,"CREATE TABLE IF NOT EXISTS customers (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, email TEXT NOT NULL, company TEXT, phone TEXT, status TEXT DEFAULT 'active')",!db_execute/2|s;10|s2|$db,"CREATE TABLE IF NOT EXISTS leads (id INTEGER PRIMARY KEY AUTOINCREMENT, company TEXT NOT NULL, contact TEXT NOT NULL, email TEXT, source TEXT, status TEXT DEFAULT 'warm', value INTEGER DEFAULT 0, score INTEGER DEFAULT 50)",!db_execute/2|s;10|s3|$db,"CREATE TABLE IF NOT EXISTS deals (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, customer TEXT, value INTEGER DEFAULT 0, stage TEXT DEFAULT 'discovery', probability INTEGER DEFAULT 50)",!db_execute/2|s;10|s4|$db,"CREATE TABLE IF NOT EXISTS activities (id INTEGER PRIMARY KEY AUTOINCREMENT, date TEXT, type TEXT, related TEXT, description TEXT)",!db_execute/2|s;10|c1|$db,"INSERT OR IGNORE INTO customers (name, email, company, phone, status) VALUES ('Alice Johnson', 'alice@acme.com', 'Acme Corp', '+1-555-0101', 'active')",!db_execute/2|s;10|c2|$db,"INSERT OR IGNORE INTO customers (name, email, company, phone, status) VALUES ('Bob Smith', 'bob@startup.io', 'Startup Inc', '+1-555-0102', 'active')",!db_execute/2|s;10|c3|$db,"INSERT OR IGNORE INTO customers (name, email, company, phone, status) VALUES ('Charlie Brown', 'charlie@enterprise.com', 'Enterprise Ltd', '+1-555-0103', 'inactive')",!db_execute/2|s;10|c4|$db,"INSERT OR IGNORE INTO customers (name, email, company, phone, status) VALUES ('Diana Prince', 'diana@tech.co', 'Tech Co', '+1-555-0104', 'active')",!db_execute/2|s;10|c5|$db,"INSERT OR IGNORE INTO customers (name, email, company, phone, status) VALUES ('Eve Wilson', 'eve@design.io', 'Design Studio', '+1-555-0105', 'lead')",!db_execute/2|s;10|l1|$db,"INSERT OR IGNORE INTO leads (company, contact, email, source, status, value, score) VALUES ('Acme Corp', 'Alice Johnson', 'alice@acme.com', 'Website', 'hot', 75000, 85)",!db_execute/2|s;10|l2|$db,"INSERT OR IGNORE I